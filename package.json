{
  "name": "portfolio-client",
  "private": true,
  "version": "1.0.0",
  "description": "React/Vite client for the portfolio site and admin CMS.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "preview": "vite preview",
    "test:concepts": "npm run build && node scripts/check-concepts.cjs",
    "predev": "node scripts/generate-section-catalog.cjs",
    "prebuild": "node scripts/generate-section-catalog.cjs",
    "pretypecheck": "node scripts/generate-section-catalog.cjs"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.0.11"
  }
}
